<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:graph="clr-namespace:UnityGraph.WPF;assembly=UnityGraph.WPF"
    xmlns:local="clr-namespace:Svetokop"
    xmlns:vm="clr-namespace:Svetokop.ViewModels">


    <Style TargetType="{x:Type vm:WpfGraphControl}">
        <Setter Property="Foreground" Value="DodgerBlue" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type vm:WpfGraphControl}">
                    <Border>
                        <Grid>
                            <graph:WpfGraphGridLines Controller="{TemplateBinding Controller}" Foreground="White" />
                            <graph:WpfGraphSurface
                                BorderBrush="{TemplateBinding Foreground}"
                                Controller="{TemplateBinding Controller}"
                                DisplayToolTip="{TemplateBinding DisplayToolTip}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
