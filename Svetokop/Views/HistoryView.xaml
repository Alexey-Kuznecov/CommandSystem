<UserControl
    x:Class="Svetokop.Views.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Svetokop.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Таблица истории  -->
            <DataGrid
                Grid.Row="0"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding CopyHistory}"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding StartTime}"
                        Header="Дата" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding FileCount}"
                        Header="Файлов" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding TotalSize}"
                        Header="Объем" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding ErrorCount}"
                        Header="Ошибки" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Status}"
                        Header="Статус" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Duration}"
                        Header="Длительность" />
                </DataGrid.Columns>
            </DataGrid>

            <!--  Детали выбранной сессии  -->
            <TextBox
                Grid.Row="1"
                IsReadOnly="True"
                Text="{Binding SelectedHistoryItem.Details}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
        </Grid>
    </Grid>
</UserControl>
