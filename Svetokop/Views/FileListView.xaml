<UserControl
    x:Class="Svetokop.Views.FileListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Svetokop.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <DockPanel Margin="5">
            <!--  Панель фильтров  -->
            <StackPanel
                Margin="0,0,0,5"
                DockPanel.Dock="Top"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Text="Показать:" />
                <ComboBox
                    Width="200"
                    Margin="0,0,10,0"
                    SelectedItem="{Binding SelectedFileFilter}">
                    <ComboBoxItem Content="Все файлы" />
                    <ComboBoxItem Content="Пропущенные" />
                    <ComboBoxItem Content="Скопированные" />
                    <ComboBoxItem Content="С ошибкой" />
                    <ComboBoxItem Content="В процессе" />
                </ComboBox>

                <TextBlock
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Text="Поиск:" />
                <TextBox Width="200" Text="{Binding FileSearchText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!--  DataGrid с файлами  -->
            <DataGrid
                AutoGenerateColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding FilesView}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Name}" Header="Имя" />
                    <DataGridTextColumn Binding="{Binding Source}" Header="Путь" />
                    <DataGridTextColumn Binding="{Binding FileSizeText}" Header="Размер" />
                    <DataGridTextColumn Binding="{Binding BytesCopiedText}" Header="Скопированно" />
                    <DataGridTextColumn Binding="{Binding Progress}" Header="Прогресс" />
                    <DataGridTextColumn Binding="{Binding Status}" Header="Статус" />
                    <!--<DataGridTextColumn Binding="{Binding ErrorMessage}" Header="Ошибка" />-->
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
