<UserControl
    x:Class="Svetokop.Views.FileListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Svetokop.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <DockPanel Margin="5">
            <!--  Панель фильтров  -->
            <StackPanel
                Margin="0,0,0,5"
                DockPanel.Dock="Top"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Text="Показать:" />
                <ComboBox
                    Width="200"
                    Margin="0,0,10,0"
                    SelectedItem="{Binding SelectedFileFilter}">
                    <ComboBoxItem Content="Все файлы" />
                    <ComboBoxItem Content="Пропущенные" />
                    <ComboBoxItem Content="Скопированные" />
                    <ComboBoxItem Content="С ошибкой" />
                    <ComboBoxItem Content="В процессе" />
                </ComboBox>

                <TextBlock
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Text="Поиск:" />
                <TextBox Width="200" Text="{Binding FileSearchText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!--  DataGrid с файлами  -->
            <DataGrid
                AlternatingRowBackground="#F9F9F9"
                AutoGenerateColumns="False"
                BorderBrush="#CCC"
                BorderThickness="1"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                CanUserResizeRows="False"
                ColumnHeaderHeight="35"
                FontFamily="Segoe UI"
                FontSize="14"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                HorizontalGridLinesBrush="#DDD"
                IsReadOnly="True"
                ItemsSource="{Binding FilteredFiles}"
                RowBackground="White"
                RowHeight="30"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                VerticalGridLinesBrush="#DDD">
                <DataGrid.Resources>
                    <!--  Подсветка при наведении  -->
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFBEE6FD" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFDDDDDD" />
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding FileName}"
                        Header="Имя" />
                    <DataGridTextColumn
                        Width="2*"
                        Binding="{Binding Source}"
                        Header="Путь" />
                    <DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding BytesCopiedText}"
                        Header="Скопированно" />
                    <DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding FileSizeText}"
                        Header="Размер" />
                    <DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding ProgressText}"
                        Header="Прогресс" />
                    <DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding Status}"
                        Header="Статус" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
