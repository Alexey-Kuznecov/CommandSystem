<UserControl
    x:Class="Svetokop.Views.MetricView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Svetokop.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock FontWeight="Bold" Text="Тестирование скорости копирования" />
            <Button Margin="0,5,0,0" Content="Запустить тест чтения" />
            <Button Margin="0,5,0,0" Content="Запустить тест записи" />
            <TextBlock Margin="0,10,0,0" Text="Результаты:" />
            <ListBox ItemsSource="{Binding MetricResults}" />
        </StackPanel>
    </Grid>
</UserControl>
