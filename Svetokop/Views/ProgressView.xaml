<UserControl
    x:Class="Svetokop.Views.ProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Svetokop.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <!--  ВЕРХНЯЯ ПАНЕЛЬ  -->
    <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <!--  Прогресс + графики  -->
            <ColumnDefinition Width="200" />
            <!--  Кнопки  -->
        </Grid.ColumnDefinitions>

        <!--  Прогресс + статистика  -->
        <StackPanel Grid.Column="0" Orientation="Vertical">
            <!--  Общий прогресс  -->
            <TextBlock FontWeight="Bold" Text="Общий прогресс" />
            <ProgressBar
                Height="20"
                Maximum="100"
                Minimum="0"
                Value="{Binding TotalProgress}" />
            <TextBlock Margin="0,5,0,10" Text="{Binding TotalProgressText}" />

            <!--  Прогресс по файлам  -->
            <TextBlock FontWeight="Bold" Text="Файлы" />
            <ProgressBar
                Height="20"
                Maximum="100"
                Minimum="0"
                Value="{Binding FileProgress}" />
            <TextBlock Margin="0,5,0,10" Text="{Binding FileProgressText}" />

            <!--  Статистика  -->
            <StackPanel Margin="0,5,0,5" Orientation="Horizontal">
                <TextBlock Width="200" Text="{Binding CurrentSpeed}" />
                <TextBlock Width="200" Text="{Binding TimeRemaining}" />
            </StackPanel>

            <!--  График скорости  -->
            <Border
                Height="300"
                Margin="0,5,0,0"
                BorderBrush="Gray"
                BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="8"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="{Binding CurrentSpeed}" />

                    <ScottPlot:WpfPlot x:Name="SpeedPlot" Grid.Row="1" />
                </Grid>
            </Border>

            <!--  Информация о текущем файле  -->
            <TextBlock
                Margin="0,5,0,0"
                FontWeight="Bold"
                Text="Текущий файл:" />
            <TextBlock Text="{Binding CurrentFileName}" />
            <TextBlock
                FontSize="12"
                FontStyle="Italic"
                Text="{Binding CurrentFilePath}" />
        </StackPanel>

        <!--  Кнопки управления  -->
        <StackPanel
            Grid.Column="1"
            HorizontalAlignment="Right"
            Orientation="Vertical">
            <Button
                Width="120"
                Margin="0,0,0,5"
                Command="{Binding StartCommand}"
                Content="Старт" />
            <Button
                Width="120"
                Margin="0,0,0,5"
                Command="{Binding PauseCommand}"
                Content="Пауза" />
            <Button
                Width="120"
                Margin="0,0,0,5"
                Command="{Binding ResumeCommand}"
                Content="Возобновить" />
            <Button
                Width="120"
                Command="{Binding CancelCommand}"
                Content="Стоп" />
        </StackPanel>
    </Grid>
</UserControl>
