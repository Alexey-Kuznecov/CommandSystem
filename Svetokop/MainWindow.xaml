<Window
    x:Class="Svetokop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Svetokop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Svetokop.Views"
    xmlns:vm="clr-namespace:Svetokop.ViewModels"
    Title="Копирование файлов"
    Width="1000"
    Height="800">

    <Window.DataContext>
        <vm:CopyWindowViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="150" />
            <!--  Верх: Progress + кнопки  -->
            <RowDefinition Height="*" />
            <!--  Вкладки  -->
        </Grid.RowDefinitions>

        <!--  Верхняя панель прогресса  -->
        <views:ProgressView Grid.Row="0" DataContext="{Binding ProgressVM}" />
        <!--  График скорости  -->
        <views:SpeedGraph Grid.Row="1" DataContext="{Binding SpeedGraphVM}" />
        <!--  Нижние вкладки  -->
        <TabControl Grid.Row="2">
            <TabItem Header="Список файлов">
                <views:FileListView DataContext="{Binding FileListVM}" />
            </TabItem>
            <TabItem Header="Настройки">
                <views:SettingsView DataContext="{Binding SettingsVM}" />
            </TabItem>
            <TabItem Header="Журнал">
                <views:LogView DataContext="{Binding LogVM}" />
            </TabItem>
            <TabItem Header="История">
                <views:HistoryView DataContext="{Binding HistoryVM}" />
            </TabItem>
            <!--<TabItem Header="METRIC">
           <views:MetricView DataContext="{Binding MetricVM}" />
       </TabItem>-->
        </TabControl>
    </Grid>

</Window>
