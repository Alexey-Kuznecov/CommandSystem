<Window
    x:Class="CommandSystem.CopyTester.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:help="clr-namespace:CommandSystem.CopyTester.Helper"
    xmlns:local="clr-namespace:CommandSystem.CopyTester"
    xmlns:views="clr-namespace:CommandSystem.CopyTester.Views"
    xmlns:vm="clr-namespace:CommandSystem.CopyTester.ViewModels"
    Title="Copy Tester"
    Width="500"
    Height="320">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:CopySetupViewModel}">
            <views:CopySetupView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CopyProgressViewModel}">
            <views:CopyProgressView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CopyReportViewModel}">
            <views:CopyReportView />
        </DataTemplate>
    </Window.Resources>
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Margin="0,0,0,10" Text="{Binding CurrentFile}" />
            <ContentControl Content="{Binding CurrentViewModel}" />
        </StackPanel>
    </Grid>
</Window>
