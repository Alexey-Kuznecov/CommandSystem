<UserControl
    x:Class="CommandSystem.CopyTester.Views.CopySetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:help="clr-namespace:CommandSystem.CopyTester.Helper"
    xmlns:local="clr-namespace:CommandSystem.CopyTester"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <help:EmptyToVisibleConverter x:Key="EmptyToVisibleConverter" />
    </UserControl.Resources>
    <Grid>
        <StackPanel>
            <!--<TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" />-->
            <TextBox Margin="0,0,0,5" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Command="{Binding StartCopyCommand}" Content="Start Copy" />
            <StackPanel Margin="10" Orientation="Vertical">
                <!--  Include Masks  -->
                <Grid Margin="0,0,0,5">
                    <TextBox x:Name="tbIncludeMasks" Text="{Binding FilterVM.IncludeMasks, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="Gray"
                        IsHitTestVisible="False"
                        Text="Маски через ;"
                        Visibility="{Binding Text, ElementName=tbIncludeMasks, Converter={StaticResource EmptyToVisibleConverter}}" />
                </Grid>
                <!--  Exclude Masks  -->
                <Grid Margin="0,0,0,5">
                    <TextBox x:Name="tbExcludeMasks" Text="{Binding FilterVM.ExcludeMasks, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="Gray"
                        IsHitTestVisible="False"
                        Text="Исключаемые маски"
                        Visibility="{Binding Text, ElementName=tbExcludeMasks, Converter={StaticResource EmptyToVisibleConverter}}" />
                </Grid>
                <!--  Include Regex  -->
                <Grid Margin="0,0,0,5">
                    <TextBox x:Name="tbIncludeRegex" Text="{Binding FilterVM.IncludeRegex, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="Gray"
                        IsHitTestVisible="False"
                        Text="Регулярки через ;"
                        Visibility="{Binding Text, ElementName=tbIncludeRegex, Converter={StaticResource EmptyToVisibleConverter}}" />
                </Grid>
                <!--  Exclude Regex  -->
                <Grid Margin="0,0,0,5">
                    <TextBox x:Name="tbExcludeRegex" Text="{Binding FilterVM.ExcludeRegex, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="Gray"
                        IsHitTestVisible="False"
                        Text="Исключаемые регулярки"
                        Visibility="{Binding Text, ElementName=tbExcludeRegex, Converter={StaticResource EmptyToVisibleConverter}}" />
                </Grid>
                <CheckBox Content="Скрытые файлы" IsChecked="{Binding FilterVM.ExcludeHidden}" />
                <CheckBox Content="Системные файлы" IsChecked="{Binding FilterVM.ExcludeSystem}" />
                <CheckBox
                    Margin="0,0,0,5"
                    Content="Только для чтения"
                    IsChecked="{Binding FilterVM.ExcludeReadOnly}" />
                <ComboBox SelectedIndex="0" SelectedItem="{Binding FilterVM.Mode}">
                    <ComboBoxItem Content="AND" />
                    <ComboBoxItem Content="OR" />
                </ComboBox>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
